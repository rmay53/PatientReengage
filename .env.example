# Copy to .env and adjust. Never commit .env.

# PostgreSQL connection (used by Prisma when running outside Docker).
# docker compose builds its own from the POSTGRES_* values.
DATABASE_URL="postgresql://reengage:reengage-local-only@localhost:5432/reengage?schema=public"

# Used by docker compose for the database container.
POSTGRES_USER=reengage
POSTGRES_PASSWORD=reengage-local-only
POSTGRES_DB=reengage

# Public URL of the app; used to build email unsubscribe links.
APP_BASE_URL=http://localhost:3000

# Set to true when served over HTTPS. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false

# Session length in hours.
SESSION_TTL_HOURS=12

# Password given to the three seeded test users (12+ characters). Seeding refuses to run without it.
SEED_USER_PASSWORD=

# Time zone for displaying dates in the UI.
DISPLAY_TIME_ZONE=America/New_York

# Optional: bcrypt cost (default 12), log level ("silent" to mute),
# force fake send failures ("sms" or "email").
# BCRYPT_ROUNDS=12
# LOG_LEVEL=info
# FAKE_SEND_FAIL=

# Integration tests only: an empty database that the tests wipe repeatedly.
# TEST_DATABASE_URL="postgresql://reengage:reengage-local-only@localhost:5432/reengage_test?schema=public"
