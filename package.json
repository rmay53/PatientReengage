{
  "name": "patient-reengagement",
  "version": "0.1.0",
  "private": true,
  "description": "Stage 2 prototype: patient re-engagement tool with approval queue (test data only).",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "sample:csv": "tsx scripts/make-sample-csv.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:all": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "bcryptjs": "3.0.3",
    "next": "15.5.28",
    "papaparse": "5.5.3",
    "prisma": "6.19.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "tsx": "4.20.6"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
